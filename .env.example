# 复制这个文件为 .env，然后填入你自己的值。
# .env 已经在 .gitignore 里，不会被提交到 GitHub。

# 大模型密钥（platform.deepseek.com → API keys → 创建）
DEEPSEEK_API_KEY=sk-你的密钥

# 接口地址，不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名，不用改
COGNITRAIL_MODEL=deepseek-chat

# 1 = 离线 Mock（不联网、不花钱，先用假数据跑通全流程）
# 0 = 调用真实模型
# 留空时：有 Key 就调真模型，没 Key 自动回退到 Mock
COGNITRAIL_MOCK=1

# 默认分析的目标仓库（命令行 --repo 优先级更高）
COGNITRAIL_REPO=

# 延迟理解探针：任务结束几天后开始复测
COGNITRAIL_DELAY_DAYS=3

# 单次任务最多生成几张卡片（手册 §10.3：目标 ≤ 5 张）
COGNITRAIL_MAX_CARDS=5
